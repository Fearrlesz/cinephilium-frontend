  animation: rf-num-in 0.16s var(--ease);
}

/* ── совместимость: эти классы используют каталог и отзывы ─ */
.btn-ghost {
  height: 42px;
  padding: 0 18px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--ink-muted);
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.btn-ghost:hover {
  border-color: var(--line-strong);
  color: var(--ink);
  background: transparent;
}

.btn-primary {
  height: 42px;
  padding: 0 22px;
  border: none;
  border-radius: var(--r-sm);
  background: var(--azure);
  color: var(--void);
  font-family: var(--sans);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.btn-primary:hover:not(:disabled) {
  background: var(--azure-bright);
  color: var(--void);
  border: none;
}

.btn-primary:disabled {
  opacity: 0.42;
}

/* ── адаптив ────────────────────────────────────────────── */
@media (max-width: 900px) {
  .rf-weight-cells {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .rf-crit {
    grid-template-columns: minmax(0, 1fr) minmax(200px, 2fr) 50px;
    gap: 14px;
  }

  .rf-foot__meta {
    display: none;
  }
}

@media (max-width: 720px) {
  .rf-scroll {
    padding: 16px 20px 22px;
  }

  .rf-genre__select {
    max-width: none;
  }

  .rf-weight-cells {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rf-crit {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'label num'
      'slider slider';
    gap: 2px 12px;
    padding: 10px 0;
  }

  .rf-crit__label {
    grid-area: label;
  }

  .rf-crit__num {
    grid-area: num;
    font-size: 24px;
  }

  .rf-crit .rs {
    grid-area: slider;
  }

  .rf-vibe__num {
    font-size: 40px;
  }

  .rf-foot {
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    padding: 12px 20px;
  }

  .rf-foot__result {
    justify-content: space-between;
  }

  .rf-foot__actions {
    width: 100%;
  }

  .rf-foot__actions .rf-btn {
    flex: 1 1 0;
  }
}

@media (max-width: 520px) {
  .rf-meter {
    display: none;
  }

  .rf-criteria-meta span:first-child {
    display: none;
  }

  .rf-foot__label {
    font-size: 11px;
    letter-spacing: 0.08em;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rf-num-in {
    animation: none;
  }

  .rf-block__chev,
  .rf-weights-viz__seg {
    transition: none;
  }
}
