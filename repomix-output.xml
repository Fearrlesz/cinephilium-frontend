import React from 'react';
import ReactDOM from 'react-dom/client';
import { BrowserRouter } from 'react-router-dom';
import './styles/tokens.css';
import './styles/base.css';
import './styles/typography.css';
import './App.css';
import CriteriaModal from './pages/FilmPage/components/CriteriaModal/CriteriaModal';
import CatalogPage from './pages/CatalogPage/CatalogPage';

const film = {
  _id: 'preview',
  title: 'Солярис',
  year: 1972,
  director: 'Андрей Тарковский'
};

const isCatalog = window.location.search.includes('catalog');

function Preview() {
  const [open, setOpen] = React.useState(true);

  React.useEffect(() => {
    const timer = setTimeout(() => {
      const width = document.documentElement.clientWidth;
      const rows = [...document.querySelectorAll('.criteria-modal, .criteria-modal *')]
        .map(el => ({ el, rect: el.getBoundingClientRect() }))
        .filter(({ rect }) => rect.right > width + 1 || rect.width > width + 1)
        .slice(0, 25)
        .map(({ el, rect }) => `${el.className || el.tagName} w=${Math.round(rect.width)} right=${Math.round(rect.right)}`);
      const pre = document.createElement('pre');
      pre.id = 'debug';
      pre.style.display = 'none';
      pre.textContent = `VIEW=${width} SCROLL=${document.documentElement.scrollWidth}\n${rows.join('\n')}`;
      document.body.appendChild(pre);
    }, 800);
    return () => clearTimeout(timer);
  }, []);

  return (
    <BrowserRouter>
      {isCatalog ? (
        <CatalogPage />
      ) : (
        <>
          <div style={{ minHeight: '100vh' }} />
          {open && (
            <CriteriaModal
              film={film}
              userRating={null}
              onClose={() => setOpen(false)}
              onSaved={() => {}}
              showNotification={() => {}}
            />
          )}
        </>
      )}
    </BrowserRouter>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<Preview />);
