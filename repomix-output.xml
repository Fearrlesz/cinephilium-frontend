<file path="src/pages/ProfilePage/ProfileCard.jsx">
import React from 'react';
import { Link } from 'react-router-dom';
import { formatDate } from '../../utils/ratingUtils';
import ProfileSettings from './ProfileSettings';

function ProfileCard({ user, isOwnProfile, onPrivacyChange }) {
  if (!user) return null;

  const counters = user.counters || {};
  const ratingCount = (counters.ratings || 0) + (counters.vibes || 0);
  const achievementsCount = user.achievementsCount
    ?? (Array.isArray(user.achievements) ? user.achievements.length : 0);
  const pinned = user.pinnedAchievement;
  const hiddenForViewer = Boolean(user.isHidden) && !isOwnProfile;

  const stats = hiddenForViewer
    ? []
    : [
        { label: 'Оценки', value: ratingCount },
        { label: 'Рецензии', value: counters.reviewsApproved || 0 },
        { label: 'Комментарии', value: counters.commentsApproved || 0 },
        { label: 'Дневник', value: counters.watches || 0 },
        { label: 'Watchlist', value: counters.watchlist || 0 },
        { label: 'Понравившиеся', value: counters.filmLikes || 0 },
      ];

  return (
    <section className="profile-card" aria-label="Карточка профиля">
      <div className="profile-avatar" aria-hidden="true">
        {user.nickname?.[0]?.toUpperCase() || '?'}
      </div>

      <div className="profile-card-body">
        <div className="profile-name-row">
          <h1 className="profile-name">{user.nickname || 'Пользователь'}</h1>
          {user.isAdmin && <span className="profile-badge">Админ</span>}
          {user.isExclusive && (
            <span className="profile-badge profile-badge--exclusive">
              Архитектор Синефилиума
            </span>
          )}
          {isOwnProfile && <span className="profile-own">Это вы</span>}
          {!hiddenForViewer && pinned && (
            <Link
              className="profile-pinned"
              to="?tab=achievements"
              title="Закреплённое достижение"
            >
              <span className="profile-pinned-mark" aria-hidden="true">◆</span>
              <span>{pinned}</span>
            </Link>
          )}
          {isOwnProfile && <ProfileSettings onPrivacyChange={onPrivacyChange} />}
        </div>

        {hiddenForViewer && (
          <p className="profile-hidden-note">
            Профиль скрыт. Показаны только ник и аватар.
          </p>
        )}

        {isOwnProfile && user.isHidden && (
          <p className="profile-hidden-note">
            Профиль скрыт от других. Вы видите его полностью.
          </p>
        )}

        {!hiddenForViewer && user.registeredAt && (
          <p className="profile-registered">
            Зарегистрирован {formatDate(user.registeredAt)}
          </p>
        )}

        {!hiddenForViewer && (
          <div className="profile-stats">
            {stats.map(stat => (
              <div className="profile-stat" key={stat.label}>
                <span className="profile-stat-label">{stat.label}</span>
                <strong className="profile-stat-value">{stat.value}</strong>
              </div>
            ))}
          </div>
        )}

        {!hiddenForViewer && (
          <div className="profile-achievement-row">
            {!pinned && (
              <span className="profile-pinned-empty">Достижение не закреплено</span>
            )}
            <Link className="profile-achievements-link" to="?tab=achievements">
              Достижения <span className="profile-ach-count">{achievementsCount}</span>
            </Link>
          </div>
        )}
      </div>
    </section>
  );
}

export default ProfileCard;
</file>

<file path="src/pages/ProfilePage/ProfileView.jsx">
import React, { useCallback, useEffect, useState } from 'react';
import api from '../../api/client';
import ProfileCard from './ProfileCard';
import ProfileTabs from './ProfileTabs';
import './ProfilePage.css';

function ProfileView({ userId, isOwnProfile, initialUser = null }) {
  const [user, setUser] = useState(initialUser);
  const [loading, setLoading] = useState(!initialUser);
  const [error, setError] = useState('');

  useEffect(() => {
    if (initialUser) {
      setUser(initialUser);
      setLoading(false);
      setError('');
      return undefined;
    }

    if (!userId) {
      setLoading(false);
      setError('Профиль не найден');
      return undefined;
    }

    let cancelled = false;
    setLoading(true);
    setError('');

    api.get(`/users/${userId}`)
      .then(response => {
        if (cancelled) return;
        setUser(response.data?.user || null);
      })
      .catch(err => {
        if (cancelled) return;
        setError(
          err.response?.status === 404
            ? 'Пользователь не найден'
            : 'Не удалось загрузить профиль'
        );
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });

    return () => { cancelled = true; };
  }, [userId, initialUser]);

  const handlePrivacyChange = useCallback((field, value) => {
    if (field !== 'hideProfile') return;
    setUser(current => (
      current ? { ...current, isHidden: value } : current
    ));
  }, []);

  const handlePinnedChange = useCallback(value => {
    setUser(current => (
      current ? { ...current, pinnedAchievement: value } : current
    ));
  }, []);

  const handleWatchlistRemoved = useCallback(() => {
    setUser(current => (
      current
        ? {
            ...current,
            counters: {
              ...(current.counters || {}),
              watchlist: Math.max(0, (current.counters?.watchlist || 0) - 1),
            },
          }
        : current
    ));
  }, []);

  const handleWatchRemoved = useCallback(() => {
    setUser(current => (
      current
        ? {
            ...current,
            counters: {
              ...(current.counters || {}),
              watches: Math.max(0, (current.counters?.watches || 0) - 1),
            },
          }
        : current
    ));
  }, []);

  if (loading) {
    return (
      <div className="profile-page">
        <div className="profile-skeleton profile-skeleton--card" aria-label="Загрузка">
          <div className="profile-skel-card">
            <div className="profile-skel-line profile-skel-line--wide" />
            <div className="profile-skel-line" />
            <div className="profile-skel-line profile-skel-line--short" />
          </div>
        </div>
      </div>
    );
  }

  if (error || !user) {
    return (
      <div className="profile-page">
        <p className="profile-error" role="alert">{error || 'Профиль не найден'}</p>
      </div>
    );
  }

  const targetUserId = user._id || user.id;

  const hiddenForViewer = Boolean(user.isHidden) && !isOwnProfile;

  return (
    <div className="profile-page">
      <ProfileCard
        user={user}
        isOwnProfile={isOwnProfile}
        onPrivacyChange={handlePrivacyChange}
      />

      {!hiddenForViewer && (
        <ProfileTabs
          userId={targetUserId}
          isOwnProfile={isOwnProfile}
          counters={user.counters}
          pinnedAchievement={user.pinnedAchievement}
          onPinnedChange={handlePinnedChange}
          onWatchlistRemoved={handleWatchlistRemoved}
          onWatchRemoved={handleWatchRemoved}
        />
      )}
    </div>
  );
}

export default ProfileView;
</file>

<file path="src/pages/ResetPasswordPage/ResetPasswordPage.jsx">
import React, { useState } from 'react';
import { Link, useSearchParams } from 'react-router-dom';
import api from '../../api/client';
import { getErrorMessage } from '../../utils/apiError';

const PASSWORD_MIN = 8;

function ResetPasswordPage() {
  const [searchParams] = useSearchParams();
  const token = searchParams.get('token') || '';

  const [password, setPassword] = useState('');
  const [confirm, setConfirm] = useState('');
  const [error, setError] = useState('');
  const [done, setDone] = useState(false);
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (event) => {
    event.preventDefault();
    setError('');

    if (password.length < PASSWORD_MIN) {
      setError(`Пароль должен содержать минимум ${PASSWORD_MIN} символов`);
      return;
    }
    if (password !== confirm) {
      setError('Пароли не совпадают');
      return;
    }

    setLoading(true);
    try {
      await api.post('/auth/reset-password', { token, newPassword: password });
      setDone(true);
      setPassword('');
      setConfirm('');
    } catch (err) {
      setError(getErrorMessage(err, 'Не удалось изменить пароль'));
    } finally {
      setLoading(false);
    }
  };

  if (!token) {
    return (
      <div className="auth-box auth-document">
        <p className="auth-kicker">Доступ</p>
        <h1 className="auth-title">Сброс пароля</h1>
        <div className="auth-error">Ссылка недействительна: в ней нет токена.</div>
        <div className="auth-links">
          <p><Link to="/forgot-password">Как получить ссылку</Link></p>
        </div>
      </div>
    );
  }

  return (
    <div className="auth-box auth-document">
      <p className="auth-kicker">Доступ</p>
      <h1 className="auth-title">Новый пароль</h1>
      <p className="auth-subtitle">Задайте пароль — после этого все старые сессии закроются.</p>

      {error && <div className="auth-error">{error}</div>}

      {done ? (
        <>
          <div className="auth-success">Пароль изменён. Теперь можно войти.</div>
          <div className="auth-links">
            <p><Link to="/login">Перейти ко входу</Link></p>
          </div>
        </>
      ) : (
        <form onSubmit={handleSubmit}>
          <label className="auth-field">
            <span>Новый пароль</span>
            <input
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              autoComplete="new-password"
              minLength={PASSWORD_MIN}
              required
            />
          </label>
          <label className="auth-field">
            <span>Повторите пароль</span>
            <input
              type="password"
              value={confirm}
              onChange={(e) => setConfirm(e.target.value)}
              autoComplete="new-password"
              minLength={PASSWORD_MIN}
              required
            />
          </label>
          <button type="submit" className="auth-submit" disabled={loading}>
            {loading ? 'Сохраняем…' : 'Изменить пароль'}
          </button>
        </form>
      )}

      {!done && (
        <div className="auth-links">
          <p><Link to="/login">Вернуться ко входу</Link></p>
        </div>
      )}
    </div>
  );
}

export default ResetPasswordPage;
</file>

