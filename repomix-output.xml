  color: var(--text-primary);
  border: 1px solid rgba(91, 155, 213, 0.15);
}
.modal-glass .btn-modal.btn-primary:hover {
  border-color: var(--gold);
  box-shadow: 0 0 40px rgba(91, 155, 213, 0.05);
  transform: translateY(-1px);
}
