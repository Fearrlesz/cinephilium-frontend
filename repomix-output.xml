/* ============================================================
   УНИВЕРСАЛЬНОЕ МОДАЛЬНОЕ ОКНО (для уведомлений) — золото
   ============================================================ */
.modal-glass {
  max-width: 420px;
  width: 100%;
  padding: 32px 36px 36px;
  background: linear-gradient(135deg,
    rgba(16, 16, 26, 0.95),
    rgba(26, 16, 36, 0.8)
  );
  backdrop-filter: blur(32px);
  -webkit-backdrop-filter: blur(32px);
  border-radius: 20px;
  border: 1px solid var(--glass-border);
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6);
  animation: modalSlide 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  text-align: center;
  position: relative;
}

/*  Золотая полоса сверху */
.modal-glass::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  width: 60%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), var(--gold-bright), var(--gold), transparent);
  opacity: 0.3;
}

@keyframes modalSlide {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modal-glass .modal-close {
  position: absolute;
  top: 16px;
  right: 20px;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 24px;
  cursor: pointer;
  transition: all 0.3s;
}
.modal-glass .modal-close:hover {
  color: var(--text-primary);
  transform: rotate(90deg);
}

.modal-glass .modal-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.modal-glass .modal-icon.success {
  background: rgba(91, 155, 213, 0.06);
  box-shadow: 0 0 40px rgba(91, 155, 213, 0.05);
}
.modal-glass .modal-icon.success span {
  filter: drop-shadow(0 0 10px rgba(91, 155, 213, 0.3));
}

.modal-glass .modal-icon.error {
  background: rgba(214, 138, 166, 0.06);
  box-shadow: 0 0 40px rgba(214, 138, 166, 0.05);
}
.modal-glass .modal-icon.error span {
  filter: drop-shadow(0 0 10px rgba(214, 138, 166, 0.3));
}

.modal-glass .modal-icon.info {
  background: rgba(91, 155, 213, 0.04);
  box-shadow: 0 0 40px rgba(91, 155, 213, 0.03);
}
.modal-glass .modal-icon.info span {
  filter: drop-shadow(0 0 10px rgba(91, 155, 213, 0.2));
}

.modal-glass .modal-icon.warning {
  background: rgba(245, 158, 11, 0.06);
  box-shadow: 0 0 40px rgba(245, 158, 11, 0.05);
}
.modal-glass .modal-icon.warning span {
  filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.3));
}

.modal-glass .modal-title {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 20px;
  color: var(--text-primary);
  margin: 0 0 8px;
  letter-spacing: -0.3px;
}

.modal-glass .modal-message {
  font-size: 15px;
  color: var(--text-secondary);
  margin: 0 0 24px;
  line-height: 1.6;
}

.modal-glass .btn-modal {
  padding: 12px 40px;
  border-radius: 40px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s;
  border: none;
