.rp-cta:hover:not(:disabled) {
  border-color: var(--azure);
  background: rgba(91, 155, 213, 0.18);
  color: #fff;
}

.rp-cta--accent {
  border-color: var(--azure);
}

.rp-cta--link {
  margin-top: 0;
  padding: 0;
  border: none;
  background: none;
  color: var(--azure-bright);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.rp-cta--link:hover {
  background: none;
  color: var(--ink);
}

.rp-formula {
  min-height: 38px;
  margin-top: 14px;
  font-family: var(--mono);
  font-size: 10.5px;
  line-height: 1.55;
  color: var(--ink-muted);
}

.rp-formula span {
  display: block;
}

.rp-formula b {
  display: block;
  font-weight: 500;
  color: var(--ink);
}

.rp-formula em {
  font-style: normal;
  color: var(--ink-faint);
}

.rp-meta {
  display: block;
  margin-top: 8px;
  font-family: var(--mono);
  font-size: 9.5px;
  line-height: 1.5;
  letter-spacing: 0.11em;
