/* ============================================================
   CRITIC PAGE — контейнер страницы критика
   ============================================================ */

.critic-page {
  padding-top: 24px;
  padding-bottom: 60px;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  animation: criticPageFadeIn 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* Верхняя кнопка «На главную» */
.critic-page .back-btn,
.back-btn {
  align-self: flex-start;
  background: rgba(20, 20, 40, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 13px;
  letter-spacing: 0.03em;
  padding: 8px 16px;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.back-btn:hover {
  color: var(--gold-bright);
  border-color: var(--gold);
  background: rgba(28, 28, 52, 0.7);
  transform: translateX(-3px);
  box-shadow:
    0 6px 24px rgba(0, 0, 0, 0.5),
    0 0 20px var(--gold-glow);
}

.back-btn:active {
  transform: translateX(-1px) scale(0.98);
}

/* Ошибка */
.critic-page .error-msg {
  background: linear-gradient(160deg,
    rgba(40, 15, 25, 0.6) 0%,
    rgba(20, 8, 15, 0.8) 100%
  );
  border: 1px solid rgba(214, 138, 166, 0.2);
  border-radius: var(--radius-xl);
  box-shadow:
    var(--shadow-card-3d),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.critic-page .error-msg h2 {
  color: var(--neon-pink);
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* Загрузка */
.critic-page .loading,
.loading {
  text-align: center;
  padding: 80px 20px;
  color: var(--text-secondary);
  font-family: var(--font-mono);
  font-size: 13px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  animation: criticPulse 1.6s ease-in-out infinite;
}

@keyframes criticPulse {
  0%, 100% { opacity: 0.5; }
  50%      { opacity: 1; }
}

@keyframes criticPageFadeIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Адаптив */
@media (max-width: 640px) {
  .critic-page {
    padding-top: 16px;
    padding-bottom: 40px;
    gap: var(--spacing-md);
  }

  .back-btn {
    font-size: 12px;
    padding: 7px 14px;
  }
}


/* ============================================================
   CRITIC PAGE — кнопка «На главную» как <Link>
   Снимаем дефолтную подчёркивающую линию и цвет ссылки
   ============================================================ */

a.back-btn,
a.back-btn:visited {
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

/* Стрелка при hover чуть «уезжает» влево — лёгкий кивок в сторону главной */
.back-btn span[aria-hidden="true"] {
  display: inline-block;
  transition: transform var(--transition-smooth);
}
.back-btn:hover span[aria-hidden="true"] {
  transform: translateX(-3px);
}

/* Фокус с клавиатуры — золотая обводка, как у остальных интерактивных элементов */
.back-btn:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
  color: var(--gold-bright);
}

/* ============================================================
   SR-ONLY — скрытый, но доступный для скринридеров текст
   ============================================================ */

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ============================================================
   RETRY — кнопка «Повторить» в блоке ошибки
   ============================================================ */

.retry-btn {
  font-family: var(--font-sans);
  font-size: 13px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--neon-pink);
  background: rgba(214, 138, 166, 0.08);
  border: 1px solid rgba(214, 138, 166, 0.35);
  padding: 10px 26px;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.retry-btn:hover {
  color: #fff;
  background: rgba(214, 138, 166, 0.18);
  border-color: var(--neon-pink);
  box-shadow:
    0 6px 24px rgba(0, 0, 0, 0.5),
    0 0 22px rgba(214, 138, 166, 0.45);
  transform: translateY(-1px);
}

.retry-btn:active {
  transform: translateY(0) scale(0.98);
}

.retry-btn:focus-visible {
  outline: 2px solid var(--neon-pink);
  outline-offset: 3px;
}

/* Описание под заголовком ошибки */
.critic-page .error-msg p {
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 1.55;
  margin: 12px auto 26px;
  max-width: 46ch;
}

/* ============================================================
   SKELETON — скелетон загрузки в стиле страницы
   Мягкое золотое мерцание на тёмном стекле
   ============================================================ */

.skeleton {
  position: relative;
  border-radius: var(--radius-lg);
  background:
    linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.03) 30%,
      rgba(212, 175, 55, 0.10) 50%,
      rgba(255, 255, 255, 0.03) 70%
    ),
    rgba(20, 20, 40, 0.55);
  background-size: 220% 100%;
  border: 1px solid var(--glass-border);
  box-shadow:
    var(--shadow-card-3d),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
  overflow: hidden;
  animation: skeletonShimmer 1.6s ease-in-out infinite;
}

/* Тонкая золотая кромка, «пробегающая» по карточке */
.skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(212, 175, 55, 0.06) 50%,
    transparent 100%
  );
  transform: translateX(-100%);
  animation: skeletonEdge 2.4s ease-in-out infinite;
  pointer-events: none;
}

.skeleton--back-btn {
  width: 148px;
  height: 36px;
  border-radius: var(--radius-md);
  margin-bottom: 4px;
}

.skeleton--hero {
  width: 100%;
  height: 280px;
  border-radius: var(--radius-xl);
}

.skeleton--row {
  width: 100%;
  height: 200px;
  border-radius: var(--radius-xl);
}

@keyframes skeletonShimmer {
  0%   { background-position: 220% 0; }
  100% { background-position: -220% 0; }
}

@keyframes skeletonEdge {
  0%   { transform: translateX(-100%); }
  60%  { transform: translateX(100%); }
  100% { transform: translateX(100%); }
}

/* ============================================================
   ДОСТУПНОСТЬ — уважение к prefers-reduced-motion
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .critic-page,
  .back-btn,
  .retry-btn,
  .loading {
    animation: none;
    transition: none;
  }

  .skeleton,
  .skeleton::after {
    animation: none;
  }

  .back-btn:hover,
  .retry-btn:hover {
    transform: none;
  }
}

/* ============================================================
   АДАПТИВ — скелетон на мобильных
   ============================================================ */

@media (max-width: 640px) {
  .skeleton--back-btn {
    width: 128px;
    height: 32px;
  }

  .skeleton--hero {
    height: 220px;
  }

  .skeleton--row {
    height: 168px;
  }

  .retry-btn {
    font-size: 12px;
    padding: 9px 22px;
  }

  .critic-page .error-msg p {
    font-size: 13px;
  }
}
</file>

