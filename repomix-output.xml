  height: 3px;
  background: var(--line);
}

.about-preset-bar {
  display: block;
  height: 100%;
  background: var(--azure);
}

.about-preset-value {
  color: var(--ink-muted);
  font-family: var(--mono);
  font-size: 9px;
  text-align: right;
}

.about-formula-steps {
  margin: 0;
  padding: 8px 0;
  list-style: none;
  counter-reset: formula;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.about-formula-steps li {
  counter-increment: formula;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr);
  gap: 12px;
  padding: 13px 0;
  border-top: 1px solid var(--line);
  color: var(--ink-soft);
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.55;
}

.about-formula-steps li:first-child {
  border-top: 0;
}

.about-formula-steps li::before {
  content: counter(formula, decimal-leading-zero);
  color: var(--azure);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
}

.about-formula-note {
  max-width: 680px;
  margin: 22px 0 0;
  color: var(--ink-faint);
  font-family: var(--sans);
  font-size: 13px;
  line-height: 1.6;
}

.about-repo {
  margin: 32px 0 0;
  padding-top: 20px;
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.about-repo a {
  color: var(--ink-muted);
  text-decoration: none;
  border-bottom: 1px solid var(--line-strong);
  padding-bottom: 2px;
  transition: color 0.14s, border-color 0.14s;
}

.about-repo a:hover {
  color: var(--ink);
  border-color: var(--azure);
}

@media (max-width: 860px) {
  .about-page {
    padding-top: 104px;
  }

  .about-block {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .about-preset-list {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .about-page {
    padding: 96px 20px 64px;
  }

  .about-intro {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .about-criteria {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .about-lead {
    font-size: 15px;
  }
}

@media (max-width: 480px) {
  .about-page {
    padding: 88px 16px 56px;
  }

  .about-preset-row {
    grid-template-columns: 84px minmax(0, 1fr) 30px;
    gap: 8px;
  }

  .about-formula-steps li {
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 8px;
    font-size: 13px;
  }
}
