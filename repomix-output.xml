<file path="src/styles/Architect.css">
/* ============================================================
   ARCHITECT.CSS — эксклюзивная тема «Архитектор Синефилиума»
   Подключается классом .exclusive-theme на .container.profile-page
   Палитра: античное золото + стерильное серебро + лёгкая ч/б зернистость
   Все селекторы с префиксом .exclusive-theme — не протекают на обычные профили
   ============================================================ */

.exclusive-theme {
  /* --- Золото (основной акцент темы) --- */
  --ex-gold:         #7eb8ea;
  --ex-gold-bright:  #7dd9e3;
  --ex-gold-deep:    #5b9bd5;
  --ex-gold-soft:    rgba(91, 155, 213, 0.10);
  --ex-gold-line:    rgba(91, 155, 213, 0.22);

  /* --- Серебро / ч-б нейтраль (второй акцент) --- */
  --ex-silver:        #d9d9d9;
  --ex-silver-bright: #f2f2f2;
  --ex-silver-dim:    rgba(217, 217, 217, 0.55);
  --ex-silver-soft:   rgba(217, 217, 217, 0.06);
  --ex-silver-line:   rgba(217, 217, 217, 0.10);

  /* --- Глубокие тона --- */
  --ex-ink:   #0b0b0c;
  --ex-paper: #fafafa;

  position: relative;
  isolation: isolate;
}

/* Лёгкая чёрно-белая зернистость поверх всей страницы профиля.
   Очень деликатная — 3% непрозрачности, без blend-mode, без вмешательства в клики. */
.exclusive-theme::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  opacity: 0.03;
  border-radius: inherit;
  background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
}

/* ============================================================
   ШАПКА
   ============================================================ */
.exclusive-theme .profile-header {
  border-color: var(--ex-silver-line);
  background:
    linear-gradient(180deg, rgba(217, 217, 217, 0.02), rgba(0, 0, 0, 0.04)),
    var(--bg-glass);
  box-shadow:
    inset 0 0 0 1px rgba(91, 155, 213, 0.04),
    0 20px 60px -20px rgba(0, 0, 0, 0.45);
}

.exclusive-theme .profile-header::before {
  left: 8%;
  width: 84%;
  opacity: 0.55;
  background: linear-gradient(
    90deg,
    transparent,
    var(--ex-silver-dim),
    var(--ex-gold),
    var(--ex-gold-bright),
    var(--ex-silver-dim),
    transparent
  );
}

/* Универсальная корректировка стекла в рамках темы */
.exclusive-theme .glass-card {
  border-color: var(--ex-silver-line);
}

/* ============================================================
   АВАТАР
   ============================================================ */
.exclusive-theme .profile-avatar {
  border-color: var(--ex-silver);
  background:
    radial-gradient(circle at 30% 30%, rgba(217, 217, 217, 0.06), rgba(0, 0, 0, 0.35));
  box-shadow:
    inset 0 0 0 1px rgba(91, 155, 213, 0.28),
    inset 0 0 22px rgba(0, 0, 0, 0.45),
    0 0 30px rgba(217, 217, 217, 0.06);
}

.exclusive-theme .profile-avatar:hover {
  border-color: var(--ex-gold-bright);
  box-shadow:
    inset 0 0 0 1px rgba(91, 155, 213, 0.5),
    0 0 44px rgba(91, 155, 213, 0.14);
}

.exclusive-theme .avatar-placeholder {
  background: linear-gradient(180deg, var(--ex-silver-bright) 0%, var(--ex-gold) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--ex-silver-bright);
  text-shadow: 0 0 24px rgba(91, 155, 213, 0.15);
}

/* ============================================================
   НИК
   ============================================================ */
.exclusive-theme .profile-info h1 {
  background: linear-gradient(180deg, var(--ex-silver-bright) 0%, var(--ex-gold) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--ex-silver-bright);
  letter-spacing: -0.01em;
  text-shadow: 0 0 30px rgba(91, 155, 213, 0.08);
}

/* Восстанавливаем видимый цвет для вложенных бейджей, т.к. h1 градиентный */
.exclusive-theme .profile-info h1 .admin-badge {
  -webkit-text-fill-color: initial;
  color: var(--ex-silver-bright);
  display: inline-block;
}

/* ============================================================
   БЕЙДЖ «АРХИТЕКТОР СИНЕФИЛИУМА» — отдельной строкой под ником
   ============================================================ */
.exclusive-theme .profile-info h1 .exclusive-badge {
  display: block;
  width: fit-content;
  margin: 10px 0 0;
  padding: 4px 14px;

  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.10em;
  line-height: 1.4;
  white-space: nowrap;

  /* Возвращаем видимость текста — родитель использует background-clip: text */
  color: var(--ex-gold-bright);
  -webkit-text-fill-color: var(--ex-gold-bright);
  background-clip: border-box;
  -webkit-background-clip: border-box;

  background:
    linear-gradient(180deg, rgba(217, 217, 217, 0.05), rgba(91, 155, 213, 0.05)),
    rgba(11, 11, 12, 0.35);
  border: 1px solid var(--ex-gold-line);
  border-radius: 999px;
