/* ============================================================
   CUSTOM SELECT — кнопка + список в стиле сайта.
   Никаких системных списков ОС, стекла и теней.
   ============================================================ */

.cselect {
  position: relative;
  width: 100%;
  min-width: 0;
}

.cselect__btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  height: 42px;
  padding: 0 36px 0 14px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  background: transparent;
  color: var(--ink);
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.3;
  text-align: left;
  justify-content: flex-start;
  cursor: pointer;
  transition:
    border-color var(--dur-fast) var(--ease),
    background var(--dur-fast) var(--ease);
}

.cselect__btn:hover:not(:disabled) {
  border-color: var(--line-strong);
  background: transparent;
  color: var(--ink);
}

.cselect.is-open .cselect__btn {
  border-color: var(--azure-line);
  background: var(--azure-soft);
}

.cselect__btn:focus-visible {
  outline: 1px solid var(--azure-line);
  outline-offset: 1px;
}

.cselect__value {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cselect__value.is-placeholder {
  color: var(--ink-muted);
}

.cselect__chev {
  position: absolute;
  top: 50%;
  right: 13px;
  width: 12px;
  height: 12px;
  flex: none;
  fill: none;
  stroke: var(--ink-faint);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  transform: translateY(-50%);
  transition: transform var(--dur-fast) var(--ease), stroke var(--dur-fast) var(--ease);
  pointer-events: none;
}

