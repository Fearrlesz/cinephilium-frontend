/* ============================================================
   GLOBAL — тёмная кинематографическая база
   Палитра: бордо (void/canvas/surface) + azure/cyan.
   Legacy-имена оставлены только как алиасы новых токенов:
   старые страницы перекрашиваются, не ломая разметку.
   ============================================================ */

:root {
  /* Legacy-алиасы */
  --bg-deep: var(--void);
  --bg-glass: var(--surface);
  --bg-glass-hover: var(--surface-2);

  --text-primary: var(--ink);
  --text-secondary: var(--ink-soft);
  --text-muted: var(--ink-faint);

  --gold: var(--azure);
  --gold-bright: var(--azure-bright);
  --gold-dim: var(--line);
  --gold-glow: var(--azure-soft);

  --neon-purple: var(--cyan);
  --neon-cyan: var(--cyan-bright);
  --neon-pink: var(--pink);
  --neon-glow: var(--cyan-soft);
  --cyan-glow: var(--cyan-soft);

  --glass-border: var(--line);
  --glass-border-hover: var(--line-strong);
  --glass-blur: 14px;

  --font-sans: var(--sans);
  --font-mono: var(--mono);

  --radius-xl: var(--r-lg);
  --radius-lg: var(--r-md);
  --radius-md: var(--r-sm);
  --spacing-lg: 24px;
  --spacing-md: 20px;
  --spacing-sm: 16px;
  --transition-smooth: var(--dur-slow) var(--ease);

  --shadow-deep: 0 30px 80px rgba(0, 0, 0, 0.55);
  --shadow-card-3d: 0 20px 60px rgba(0, 0, 0, 0.45);
  --shadow-inset-3d: inset 0 1px 0 rgba(237, 232, 224, 0.04);
}

/* ============================================================
   LAYOUT
   ============================================================ */
.container {
  max-width: var(--wrap);
  margin: 0 auto;
  padding: 76px 24px 64px;
}

.loading {
  padding: 60px 20px;
  text-align: center;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--ink-faint);
}

.error {
  padding: 60px 20px;
  text-align: center;
  color: var(--pink);
}

/* ============================================================
   FLAT SURFACES — вместо стекла и неона
   ============================================================ */
.glass-card,
.criteria-block,
.vibe-block {
  position: relative;
  width: 100%;
  padding: 24px;
  margin-bottom: 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.glass-card:hover,
.criteria-block:hover,
.vibe-block:hover {
  border-color: var(--line-strong);
  transform: none;
  box-shadow: none;
}

.block-divider {
  width: 100%;
  height: 1px;
  margin: 24px 0;
  border: none;
  background: var(--line-faint);
}

.gold-text,
.neon-text {
  color: var(--azure-bright);
}

.gold-text strong,
.neon-text strong {
  color: var(--ink);
}

.film-frame {
  position: relative;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
}

.film-frame::before,
.film-frame::after {
  display: none;
}

.dust-particles {
  display: none;
}

/* ============================================================
   BUTTONS / CONTROLS
   ============================================================ */
button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: auto;
  padding: 8px 15px;
  border: 1px solid var(--line);
  border-radius: 100px;
  background: transparent;
  color: var(--ink-muted);
  font-family: var(--sans);
  font-size: 12.5px;
  font-weight: 500;
  line-height: 1.3;
  cursor: pointer;
  transition:
    border-color var(--dur-fast) var(--ease),
    color var(--dur-fast) var(--ease),
    background var(--dur-fast) var(--ease);
}

button:hover:not(:disabled) {
  border-color: var(--line-strong);
  color: var(--ink);
  background: rgba(237, 232, 224, 0.04);
}

button:disabled {
  opacity: 0.42;
  cursor: not-allowed;
}

input,
select,
textarea {
  font: inherit;
  color: var(--ink);
}

/* ============================================================
   SMALL GLOBAL BITS
   ============================================================ */
.admin-badge {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 6px;
  border: 1px solid var(--line);
  border-radius: var(--r-xs);
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-faint);
}

.char-counter {
  margin-top: 4px;
  text-align: right;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-faint);
}

/* ============================================================
   GENERIC MODAL — используется страницами и деталями оценки
   ============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(10, 7, 9, 0.86);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

.modal-content {
  position: relative;
  width: 100%;
  max-width: 600px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 26px;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-radius: var(--r-lg);
  box-shadow: 0 40px 90px rgba(0, 0, 0, 0.9);
}

.modal-content::-webkit-scrollbar {
  width: 4px;
}

.modal-content::-webkit-scrollbar-thumb {
  background: var(--line-strong);
  border-radius: 4px;
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 2;
  width: 30px;
  height: 30px;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: transparent;
  color: var(--ink-muted);
  font-family: var(--mono);
  font-size: 15px;
  line-height: 1;
}

.modal-close:hover {
  color: var(--ink);
  border-color: var(--line-strong);
  background: rgba(237, 232, 224, 0.04);
}
</file>

