/* ── Адаптив ──────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .hdr-in {
    gap: 20px;
  }

  .nav {
    gap: 18px;
  }

  .tool-contact-full {
    display: none;
  }

  .tool-contact-short {
    display: inline;
  }
}

@media (max-width: 768px) {
  .hdr-in {
    gap: 12px;
    padding: 0 16px;
  }

  .nav {
    display: none;
  }

  .tool-search,
  .tool-contact {
    display: none;
  }

  .hdr-burger {
    display: inline-block;
  }

  .tools {
    gap: 12px;
  }

  .brand {
    margin-right: auto;
  }

  .hdr-mobile-nav {
    padding: 8px 16px 16px;
  }
}

@media (max-width: 480px) {
  .brand {
    font-size: 10.5px;
    letter-spacing: 0.18em;
  }

  .tool-link {
    font-size: 9.5px;
  }

  .avatar {
    width: 24px;
    height: 24px;
  }
}
</file>

