import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../../api/client';
import { useNotification } from '../../context/NotificationContext';
import './AdminPanel.css';

const INVITE_STATUS_LABELS = {
  active: 'свободен',
  used: 'использован',
  expired: 'истёк',
  revoked: 'отозван'
};

function AdminPanel() {
  const navigate = useNavigate();
  const [user, setUser] = useState(null);
  const [pendingComments, setPendingComments] = useState([]);
  const [pendingReviews, setPendingReviews] = useState([]);
  const [invites, setInvites] = useState([]);
  const [inviteQuantity, setInviteQuantity] = useState(1);
  const [inviteNote, setInviteNote] = useState('');
  const [freshCodes, setFreshCodes] = useState([]);
  const [userQuery, setUserQuery] = useState('');
  const [foundUsers, setFoundUsers] = useState([]);
  const [resetLink, setResetLink] = useState(null);
  const [contactRequests, setContactRequests] = useState([]);
  const [freshInvite, setFreshInvite] = useState(null);
  const [tgDrafts, setTgDrafts] = useState({});
  const [loading, setLoading] = useState(true);
  const { showNotification } = useNotification();

  useEffect(() => {
    const token = localStorage.getItem('token');
    if (!token) {
      navigate('/login');
      return;
    }
    loadAdminData();
  }, [navigate]);

  const loadAdminData = async () => {
    try {
      const userResponse = await api.get('/auth/me');
      setUser(userResponse.data);
      if (!userResponse.data.isAdmin) {
        navigate('/');
        return;
      }
      const [commentsRes, reviewsRes, invitesRes, requestsRes] = await Promise.all([
        api.get('/admin/pending/comments'),
        api.get('/admin/pending/reviews'),
        api.get('/admin/invites'),
        api.get('/admin/contact-requests')
      ]);
      setPendingComments(commentsRes.data || []);
      setPendingReviews(reviewsRes.data || []);
      setInvites(invitesRes.data || []);
      setContactRequests(requestsRes.data || []);
    } catch (err) {
      console.error('Ошибка загрузки админ-панели:', err);
      navigate('/');
    } finally {
      setLoading(false);
    }
  };

  const approveComment = async (id) => {
    try {
      await api.put(`/admin/comments/${id}/approve`);
      setPendingComments(prev => prev.filter(c => c._id !== id));
      showNotification({ title: 'Одобрено', message: 'Комментарий опубликован', type: 'success' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось одобрить комментарий', type: 'error' });
    }
  };

  const rejectComment = async (id) => {
    try {
      await api.put(`/admin/comments/${id}/reject`);
      setPendingComments(prev => prev.filter(c => c._id !== id));
      showNotification({ title: 'Отклонено', message: 'Комментарий отклонён', type: 'info' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось отклонить комментарий', type: 'error' });
    }
  };

  const approveReview = async (id) => {
    try {
      await api.put(`/admin/reviews/${id}/approve`);
      setPendingReviews(prev => prev.filter(r => r._id !== id));
      showNotification({ title: 'Одобрено', message: 'Рецензия опубликована', type: 'success' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось одобрить рецензию', type: 'error' });
    }
  };

  const rejectReview = async (id) => {
    try {
      await api.put(`/admin/reviews/${id}/reject`);
      setPendingReviews(prev => prev.filter(r => r._id !== id));
      showNotification({ title: 'Отклонено', message: 'Рецензия отклонена', type: 'info' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось отклонить рецензию', type: 'error' });
    }
  };

  const createInvites = async () => {
    try {
      const response = await api.post('/admin/invites', {
        quantity: Number(inviteQuantity) || 1,
        note: inviteNote.trim() || undefined
      });
      setFreshCodes(response.data?.invites || []);
      setInviteNote('');
      const list = await api.get('/admin/invites');
      setInvites(list.data || []);
      showNotification({ title: 'Коды созданы', message: 'Скопируй их: в списке они больше не появятся', type: 'success' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось создать коды', type: 'error' });
    }
  };

  const revokeInvite = async (id) => {
    try {
      await api.delete(`/admin/invites/${id}`);
      setInvites(prev => prev.map(invite => (invite.id === id ? { ...invite, status: 'revoked' } : invite)));
      showNotification({ title: 'Код отозван', message: 'Зарегистрироваться по нему больше нельзя', type: 'info' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось отозвать код', type: 'error' });
    }
  };

  const searchUsers = async () => {
    try {
      const response = await api.get('/admin/users', { params: { query: userQuery.trim() } });
      setFoundUsers(response.data || []);
      if ((response.data || []).length === 0) {
        showNotification({ title: 'Никого не нашли', message: 'Проверь никнейм', type: 'info' });
      }
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось выполнить поиск', type: 'error' });
    }
  };

  const issueResetLink = async (userId) => {
    try {
      const response = await api.post(`/admin/users/${userId}/reset-link`);
      setResetLink(response.data);
      showNotification({ title: 'Ссылка готова', message: 'Передай её пользователю', type: 'success' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось создать ссылку', type: 'error' });
    }
  };

  const toggleAdmin = async (found) => {
    const next = !found.isAdmin;
    try {
      const response = await api.post(`/admin/users/${found.id}/admin`, { isAdmin: next });
      setFoundUsers(prev => prev.map(item => (
        item.id === found.id ? { ...item, isAdmin: response.data.isAdmin } : item
      )));
      showNotification({
        title: next ? 'Права выданы' : 'Права сняты',
        message: next ? `${found.nickname} теперь администратор` : `${found.nickname} больше не администратор`,
        type: 'success'
      });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось изменить права', type: 'error' });
    }
  };

  const approveRequest = async (request) => {
    try {
      const response = await api.post(`/admin/contact-requests/${request.id}/approve`);
      setContactRequests(prev => prev.filter(item => item.id !== request.id));
      setFreshInvite(response.data);
      const list = await api.get('/admin/invites');
      setInvites(list.data || []);
      showNotification({
        title: 'Инвайт создан',
        message: `Скопируй код и отправь на ${request.contact}`,
        type: 'success'
      });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось одобрить заявку', type: 'error' });
    }
  };

  const rejectRequest = async (request) => {
    try {
      await api.post(`/admin/contact-requests/${request.id}/reject`);
      setContactRequests(prev => prev.filter(item => item.id !== request.id));
      showNotification({ title: 'Заявка отклонена', message: request.nickname, type: 'info' });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось отклонить заявку', type: 'error' });
    }
  };

  const saveTelegram = async (found) => {
    const value = tgDrafts[found.id] ?? found.telegram ?? '';
    try {
      const response = await api.post(`/admin/users/${found.id}/telegram`, { telegram: value });
      setFoundUsers(prev => prev.map(item => (
        item.id === found.id ? { ...item, telegram: response.data.telegram } : item
      )));
      setTgDrafts(prev => ({ ...prev, [found.id]: undefined }));
      showNotification({
        title: 'Телеграм сохранён',
        message: response.data.telegram ? `@${response.data.telegram}` : 'Контакт очищен',
        type: 'success'
      });
    } catch (err) {
      showNotification({ title: 'Ошибка', message: err.response?.data?.error || 'Не удалось сохранить телеграм', type: 'error' });
    }
  };

  const copyText = async (text, label) => {
    try {
      await navigator.clipboard.writeText(text);
      showNotification({ title: 'Скопировано', message: label, type: 'success' });
    } catch {
      showNotification({ title: 'Не вышло скопировать', message: 'Выдели текст вручную', type: 'error' });
    }
  };

  if (loading) return <div className="loading">Загрузка...</div>;

  return (
    <div className="container admin-panel">
      <button onClick={() => navigate('/')} className="admin-back">← На главную</button>
      <p className="admin-kicker">Служебный раздел</p>
      <h1 className="admin-title">Админ-панель</h1>
      <p className="admin-welcome">{user?.nickname}</p>

      <div className="admin-section glass-card">
        <h2> Заявки на регистрацию ({contactRequests.length})</h2>
        <p className="admin-hint">
          Заявки со страницы «Связь с админами». Одобрение сразу создаёт инвайт-код —
          его нужно отправить по контакту из заявки.
        </p>

        {freshInvite && (
          <div className="admin-fresh">
            <p>
              Код для <strong>{freshInvite.nickname}</strong> (контакт: {freshInvite.contact}):
            </p>
            <div className="admin-codes">
              <code>{freshInvite.code}</code>
            </div>
            <button className="btn-approve" onClick={() => copyText(freshInvite.code, 'Код в буфере')}>
              Скопировать код
            </button>
          </div>
        )}

        {contactRequests.length === 0 ? (
          <p className="admin-empty">Новых заявок нет</p>
        ) : (
          <div className="admin-list">
            {contactRequests.map(request => (
              <div key={request.id} className="admin-item">
                <div className="admin-item-header">
                  <span className="admin-item-author"> {request.nickname}</span>
                  <span className="admin-item-film"> {request.contact}</span>
                </div>
                {request.message && <p className="admin-item-text">{request.message}</p>}
                <div className="admin-item-actions">
                  <button className="btn-approve" onClick={() => approveRequest(request)}> Выдать инвайт</button>
                  <button className="btn-reject" onClick={() => rejectRequest(request)}> Отклонить</button>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="admin-section glass-card">
        <h2> Инвайт-коды</h2>
        <p className="admin-hint">
          Один код — один аккаунт. Коды показываются один раз, в списке остаётся только префикс.
        </p>

        <div className="admin-form-row">
          <input
            type="number"
            min="1"
            max="50"
            value={inviteQuantity}
            onChange={(e) => setInviteQuantity(e.target.value)}
            aria-label="Сколько кодов выдать"
          />
          <input
            type="text"
            placeholder="Заметка (для себя)"
            value={inviteNote}
            onChange={(e) => setInviteNote(e.target.value)}
            maxLength={200}
          />
          <button className="btn-approve" onClick={createInvites}>Выдать коды</button>
        </div>

        {freshCodes.length > 0 && (
          <div className="admin-fresh">
            <p>Сохрани коды сейчас — потом их не показать:</p>
            <div className="admin-codes">
              {freshCodes.map(item => (
                <code key={item.code}>{item.code}</code>
              ))}
            </div>
            <button
              className="btn-approve"
              onClick={() => copyText(freshCodes.map(item => item.code).join('\n'), 'Все коды в буфере')}
            >
              Скопировать все
            </button>
          </div>
        )}

        {invites.length === 0 ? (
          <p className="admin-empty">Кодов пока нет</p>
