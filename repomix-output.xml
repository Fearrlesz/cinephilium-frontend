<file path="src/components/RangeSlider/RangeSlider.css">
/* ============================================================
   RANGE SLIDER — трек 8px, бегунок 20px, деления, «липкий» режим.
   Нативный input остаётся сверху и отвечает за ввод.
   ============================================================ */

.rs {
  position: relative;
  height: 34px;
  min-width: 0;
  --p: 0;
}

.rs__input {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
  outline: none;
  touch-action: none;
}

.rs__input::-webkit-slider-runnable-track {
  height: 34px;
  background: transparent;
  border: 0;
}

.rs__input::-webkit-slider-thumb {
  width: 20px;
  height: 20px;
  margin-top: 7px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
  appearance: none;
  -webkit-appearance: none;
}

.rs__input::-moz-range-track {
  height: 34px;
  background: transparent;
  border: 0;
}

.rs__input::-moz-range-progress {
  background: transparent;
}

.rs__input::-moz-range-thumb {
  width: 20px;
  height: 20px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
}

.rs__input:disabled {
  cursor: not-allowed;
}

.rs__track {
  position: absolute;
  left: 0;
  right: 0;
  top: 13px;
  height: 8px;
  border-radius: 4px;
  background: var(--line);
  pointer-events: none;
}

.rs__fill {
  display: block;
  height: 100%;
  width: calc(10px + (100% - 20px) * var(--p));
  border-radius: 4px;
  background: var(--fc, var(--azure));
  transition: width 0.07s linear;
}

.rs__ticks {
  position: absolute;
  left: 10px;
  right: 10px;
  top: 25px;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
}

.rs__ticks i {
  width: 2px;
  height: 4px;
  border-radius: 1px;
  background: var(--line-strong);
}

.rs__ticks i.is-on {
  background: var(--fc, var(--azure));
  opacity: 0.62;
}

.rs__thumb {
  position: absolute;
  top: 50%;
  left: calc(10px + (100% - 20px) * var(--p));
  z-index: 1;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--ink);
  transform: translate(-50%, -50%);
  pointer-events: none;
  transition:
    transform var(--dur-fast) var(--ease),
    box-shadow var(--dur-fast) var(--ease);
}

.rs:hover .rs__thumb {
  transform: translate(-50%, -50%) scale(1.08);
}

.rs.is-armed .rs__thumb {
  box-shadow: 0 0 0 5px rgba(237, 232, 224, 0.10);
}

.rs.is-armed:hover .rs__thumb {
  transform: translate(-50%, -50%) scale(1.12);
}

.rs__input:focus-visible ~ .rs__thumb {
  box-shadow: 0 0 0 4px var(--azure-line);
}

.rs.is-disabled {
  opacity: 0.5;
}

@media (prefers-reduced-motion: reduce) {
  .rs__fill,
  .rs__thumb {
    transition: none;
  }
}
</file>

<file path="src/components/RangeSlider/RangeSlider.jsx">
import React, { useEffect, useMemo, useRef, useState } from 'react';
import './RangeSlider.css';

const THUMB_RADIUS = 10;

function clamp(value, min, max) {
  return Math.min(max, Math.max(min, value));
}

/**
 * Ползунок формы оценки.
 *
 * DECISION: визуальный трек/бегунок рисуем сами, но ввод остаётся нативным
 * input range — клавиатура, step и тач работают из коробки.
 *
 * «Липкий» режим: после клика мышью бегунок следует за курсором, пока он
 * над шкалой, и не требует держать кнопку. Отпускают: уход курсора,
 * клик мимо, Esc, потеря фокуса.
 */
export default function RangeSlider({
  id,
  min = 1,
  max = 10,
  step = 1,
  value,
  onChange = () => {},
  color,
  ticks,
  ariaLabel,
  className = '',
  disabled = false
}) {
  const inputRef = useRef(null);
  const draggingRef = useRef(false);
  const [armed, setArmed] = useState(false);

  const percent = max === min ? 0 : clamp((value - min) / (max - min), 0, 1);
  const tickValues = useMemo(() => {
    if (Array.isArray(ticks)) return ticks;
    const result = [];
    for (let tick = min; tick <= max; tick += step) result.push(tick);
    return result;
  }, [ticks, min, max, step]);

  const valueFromClientX = clientX => {
    const element = inputRef.current;
    if (!element) return value;
    const rect = element.getBoundingClientRect();
    if (!rect.width) return value;
    const ratio = clamp(
      (clientX - rect.left - THUMB_RADIUS) / (rect.width - THUMB_RADIUS * 2),
      0,
      1
    );
    const raw = min + ratio * (max - min);
    const stepped = Math.round(raw / step) * step;
    return clamp(stepped, min, max);
  };

  useEffect(() => {
    if (!armed) return undefined;

    const releaseOnOutside = event => {
      if (!inputRef.current?.contains(event.target)) setArmed(false);
    };
    const releaseOnEscape = event => {
      if (event.key === 'Escape') setArmed(false);
    };

    document.addEventListener('pointerdown', releaseOnOutside);
    document.addEventListener('keydown', releaseOnEscape);
    return () => {
      document.removeEventListener('pointerdown', releaseOnOutside);
      document.removeEventListener('keydown', releaseOnEscape);
    };
  }, [armed]);

  const handlePointerDown = event => {
    if (disabled) return;
    draggingRef.current = true;
    if (event.pointerType === 'mouse') setArmed(true);
  };

  const handlePointerMove = event => {
    if (!armed || draggingRef.current || disabled) return;
    const next = valueFromClientX(event.clientX);
    if (next !== value) onChange(next);
  };

  const handlePointerUp = event => {
    draggingRef.current = false;
    const element = inputRef.current;
    if (!element) return;
    const rect = element.getBoundingClientRect();
    const inside = event.clientX >= rect.left && event.clientX <= rect.right
      && event.clientY >= rect.top && event.clientY <= rect.bottom;
    if (!inside) setArmed(false);
  };

  const handlePointerLeave = () => {
    if (!draggingRef.current) setArmed(false);
  };

  const handleKeyDown = event => {
    if (event.key === 'Escape' && armed) {
      setArmed(false);
      // Escape отпускает «липкий» бегунок, но не закрывает модалку.
      event.stopPropagation();
    }
  };

  const classNameFull = [
    'rs',
    armed ? 'is-armed' : '',
    draggingRef.current ? 'is-dragging' : '',
    disabled ? 'is-disabled' : '',
    className
  ].filter(Boolean).join(' ');

  return (
    <div
      className={classNameFull}
      style={{ '--p': percent, '--fc': color }}
    >
      <input
        ref={inputRef}
        id={id}
        className="rs__input"
        type="range"
        min={min}
        max={max}
        step={step}
        value={value}
        disabled={disabled}
        aria-label={ariaLabel}
        onChange={event => onChange(Number(event.target.value))}
        onPointerDown={handlePointerDown}
        onPointerMove={handlePointerMove}
        onPointerUp={handlePointerUp}
        onPointerCancel={() => { draggingRef.current = false; }}
        onPointerLeave={handlePointerLeave}
        onKeyDown={handleKeyDown}
      />
      <span className="rs__track" aria-hidden="true">
        <span className="rs__fill" />
      </span>
      <span className="rs__ticks" aria-hidden="true">
        {tickValues.map(tick => (
          <i key={tick} className={tick <= value + 0.001 ? 'is-on' : ''} />
        ))}
      </span>
      <span className="rs__thumb" aria-hidden="true" />
    </div>
  );
}
</file>

