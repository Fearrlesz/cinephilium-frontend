<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="dsh-design" content="web" />
  <title>Форма оценки · Cinephilium</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* ============================================================
       Макет формы оценки (обсуждение). Токены — из src/styles/tokens.css.
       ============================================================ */
    :root {
      --void: #0a0709;
      --canvas: #130d11;
      --surface: #1e151b;
      --surface-2: #251a22;
      --ink: #f0ebe4;
      --ink-soft: #cfc6c6;
      --ink-muted: #a89aa0;
      --ink-faint: #8f8289;
      --line-faint: rgba(237, 232, 224, 0.06);
      --line: rgba(237, 232, 224, 0.10);
      --line-strong: rgba(237, 232, 224, 0.16);
      --azure: #5b9bd5;
      --azure-bright: #7eb8ea;
      --azure-soft: rgba(91, 155, 213, 0.10);
      --azure-line: rgba(91, 155, 213, 0.38);
      --cyan: #5fc9d4;
      --cyan-bright: #7dd9e3;
      --pink: #d68aa6;
      --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --serif: 'Instrument Serif', Georgia, serif;
      --r-xs: 4px;
      --r-sm: 6px;
      --r-md: 10px;
      --r-lg: 14px;
      --ease: cubic-bezier(.33, 0, .2, 1);
      --thumb: 20px;
    }

    * { box-sizing: border-box; }

    html, body { height: 100%; }

    body {
      margin: 0;
      background: var(--void);
      color: var(--ink);
      font-family: var(--sans);
      -webkit-font-smoothing: antialiased;
    }

    /* ── фон «страницы фильма» за модалкой ──────────────────── */
    .backdrop-page {
      position: fixed;
      inset: 0;
      display: flex;
      gap: 48px;
      align-items: flex-start;
      justify-content: center;
      padding: 90px 40px;
      filter: blur(10px);
      opacity: .5;
      pointer-events: none;
    }
    .bp-poster {
      width: 230px; height: 340px; flex: none;
      border-radius: 6px;
      background: linear-gradient(160deg, #2b1d26, #171017 60%, #0d090c);
    }
    .bp-main { width: 620px; padding-top: 10px; }
    .bp-kicker { width: 90px; height: 9px; background: var(--line-strong); border-radius: 2px; }
    .bp-h1 { width: 320px; height: 40px; margin: 22px 0 14px; background: var(--line-strong); border-radius: 3px; }
    .bp-line { height: 10px; margin: 10px 0; background: var(--line); border-radius: 2px; }
    .bp-line.w70 { width: 70%; } .bp-line.w90 { width: 90%; } .bp-line.w50 { width: 50%; }

    /* ── оверлей и диалог ───────────────────────────────────── */
    .overlay {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(10, 7, 9, .82);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .dialog {
      position: relative;
      display: flex;
      flex-direction: column;
      width: min(980px, 100%);
      max-height: 92vh;
      background: var(--surface);
      border: 1px solid var(--line-strong);
      border-radius: var(--r-lg);
      overflow: hidden;
    }

    .dialog__head {
      flex: none;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      padding: 24px 28px 18px;
      border-bottom: 1px solid var(--line-faint);
    }

    .kicker {
      margin: 0 0 6px;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    .dialog__title {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -.015em;
      color: var(--ink);
    }

    .dialog__sub {
      margin: 6px 0 0;
      font-size: 13px;
      color: var(--ink-muted);
    }

    .dialog__close {
      flex: none;
      width: 32px;
      height: 32px;
      margin-top: 2px;
      border: 1px solid var(--line);
      border-radius: 50%;
      background: transparent;
      color: var(--ink-muted);
      font-family: var(--mono);
      font-size: 15px;
      line-height: 1;
      cursor: pointer;
      transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
    }
    .dialog__close:hover { color: var(--ink); border-color: var(--line-strong); }

    /* ── прокручиваемая часть ───────────────────────────────── */
    .rf-scroll {
      flex: 1 1 auto;
      min-height: 0;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 20px 28px 26px;
      scrollbar-width: thin;
      scrollbar-color: var(--line-strong) transparent;
    }
    .rf-scroll::-webkit-scrollbar { width: 6px; }
    .rf-scroll::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 6px; }

    .lbl {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: .13em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    /* ── общая «карточка» секции ────────────────────────────── */
    .card {
      padding: 18px 20px 20px;
      border: 1px solid var(--line-faint);
      border-radius: var(--r-md);
      background: rgba(37, 26, 34, .34);
    }

    .card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 14px;
    }

    /* ── жанр ───────────────────────────────────────────────── */
    .genre-row {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .select-wrap { position: relative; flex: 1 1 auto; max-width: 380px; }

    .field-select {
      width: 100%;
      height: 42px;
      padding: 0 38px 0 14px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: transparent;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 13px;
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      outline: none;
      transition: border-color .16s var(--ease), background .16s var(--ease);
    }
    .field-select:focus-visible { border-color: var(--azure-line); background: var(--azure-soft); }
    .field-select option { background: var(--surface-2); color: var(--ink); }

    .select-wrap svg {
      position: absolute;
      top: 50%; right: 14px;
      width: 12px; height: 12px;
      fill: none; stroke: var(--ink-faint); stroke-width: 1.6;
      stroke-linecap: round; stroke-linejoin: round;
      transform: translateY(-50%);
      pointer-events: none;
    }

    .weights-sum {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-left: auto;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .02em;
      color: var(--ink-muted);
      white-space: nowrap;
    }
    .weights-sum b { font-weight: 500; color: var(--ink); }
    .weights-sum.is-invalid { color: var(--pink); }
    .weights-sum.is-invalid b { color: var(--pink); }

    .link-btn {
      padding: 5px 4px;
      margin: -5px -4px;
      border: 0;
      background: none;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--azure-bright);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
      white-space: nowrap;
    }
    .link-btn:hover { color: var(--ink); }

    /* ── полоса распределения весов ─────────────────────────── */
    .weights-viz {
      display: flex;
      height: 26px;
      margin-top: 16px;
      overflow: hidden;
      border-radius: var(--r-xs);
      background: var(--line-faint);
    }
    .weights-viz__seg {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
      overflow: hidden;
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      color: rgba(10, 7, 9, .82);
      white-space: nowrap;
      transition: flex-grow .18s var(--ease);
    }
    .weights-viz__seg[data-empty="true"] { color: transparent; }

    /* ── 5 ячеек весов ──────────────────────────────────────── */
    .weight-cells {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px 20px;
      margin-top: 18px;
    }

    .weight-cell { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

    .weight-cell__top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
      min-width: 0;
    }

    .weight-cell__name {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
      font-size: 12px;
      color: var(--ink-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .dot { width: 6px; height: 6px; flex: none; border-radius: 2px; }

    .weight-cell__val {
      font-family: var(--mono);
      font-size: 18px;
      font-weight: 500;
      letter-spacing: -.02em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .weight-cell__val span { font-size: 12px; color: var(--ink-faint); margin-left: 2px; }

    /* ── критерии ───────────────────────────────────────────── */
    .criteria-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      padding: 4px 2px 0;
    }
    .criteria-head__meta {
      display: flex;
      align-items: baseline;
      gap: 14px;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .05em;
      color: var(--ink-faint);
    }

    .blocks { display: flex; flex-direction: column; gap: 10px; }

    .block {
      position: relative;
      border: 1px solid var(--line-faint);
      border-radius: var(--r-md);
      background: rgba(37, 26, 34, .34);
      overflow: hidden;
    }
    .block::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--bc);
      opacity: .9;
    }
    .block.is-open { border-color: var(--line); }

    .block__head {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 14px 18px 14px 20px;
      border: 0;
      background: transparent;
      color: inherit;
      text-align: left;
      cursor: pointer;
    }
    .block__head:hover { background: rgba(237, 232, 224, .025); }
    .block.is-open .block__head { padding-bottom: 10px; }

    .block__name {
      flex: 1 1 auto;
      min-width: 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--ink);
    }

    .meter { display: flex; gap: 4px; flex: none; }
    .meter i {
      width: 6px; height: 6px;
      border-radius: 1.5px;
      background: var(--line-strong);
    }
    .meter i.is-on { background: var(--bc); }

    .block__avg {
      min-width: 2ch;
      text-align: right;
      font-family: var(--mono);
      font-size: 16px;
      font-weight: 500;
      color: var(--ink-soft);
      font-variant-numeric: tabular-nums;
    }

    .block__chev {
      width: 14px; height: 14px;
      flex: none;
      fill: none;
      stroke: var(--ink-faint);
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: transform .18s var(--ease);
    }
    .block.is-open .block__chev { transform: rotate(180deg); }

    .block__body { display: none; padding: 0 18px 12px 20px; }
    .block.is-open .block__body { display: block; }

    /* ── строка критерия ────────────────────────────────────── */
    .crit {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 2.5fr) 56px;
      align-items: center;
      gap: 20px;
      padding: 7px 0;
    }
    .crit + .crit { border-top: 1px solid var(--line-faint); }

    .crit__label {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
      font-size: 13px;
      line-height: 1.35;
      color: var(--ink-soft);
      cursor: pointer;
    }

    .hint {
      position: relative;
      flex: none;
      width: 24px; height: 24px;
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 0;
      color: var(--ink-faint);
      cursor: help;
    }
    .hint::before {
      content: 'i';
      position: absolute;
      inset: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--line);
      border-radius: 50%;
      font-family: var(--mono);
      font-size: 9px;
      font-style: italic;
      line-height: 1;
    }
    .hint:hover::before, .hint:focus-visible::before { border-color: var(--line-strong); color: var(--ink); }
    .hint:focus-visible { outline: 1px solid var(--azure-line); outline-offset: 0; border-radius: 50%; }

    .hint-wrap { position: relative; display: inline-flex; }
    .hint-popup {
      position: absolute;
      bottom: calc(100% + 8px);
      left: 50%;
      z-index: 5;
      width: max-content;
      max-width: min(280px, 60vw);
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--r-sm);
      background: var(--surface-2);
      color: var(--ink-soft);
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 400;
      line-height: 1.5;
      transform: translateX(-50%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity .12s var(--ease);
    }
    .hint-wrap:hover .hint-popup,
    .hint-wrap:focus-within .hint-popup { opacity: 1; visibility: visible; }

    .crit__num {
      text-align: right;
      font-family: var(--mono);
      font-size: 28px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: -.04em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }

    /* ── слайдер ────────────────────────────────────────────── */
    .slider {
      position: relative;
      height: 34px;
      display: flex;
      align-items: flex-start;
      --p: 0;
    }

    .slider__track {
      position: absolute;
      left: 0; right: 0; top: 13px;
      height: 8px;
      border-radius: 4px;
      background: var(--line);
    }

    .slider__fill {
      display: block;
      height: 100%;
      width: calc(10px + (100% - 20px) * var(--p));
      border-radius: 4px;
      background: var(--fc, var(--azure));
      transition: width .09s linear;
    }

    .slider__ticks {
      position: absolute;
      left: 10px; right: 10px; top: 25px;
      display: flex;
      justify-content: space-between;
      pointer-events: none;
    }
    .slider__ticks i {
      width: 2px; height: 4px;
      border-radius: 1px;
      background: var(--line-strong);
    }
    .slider__ticks i.is-on { background: var(--fc, var(--azure)); opacity: .62; }

    .slider input[type="range"] {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
      cursor: pointer;
      outline: none;
    }

    .slider input[type="range"]::-webkit-slider-runnable-track { height: 34px; background: transparent; }
    .slider input[type="range"]::-webkit-slider-thumb {
      width: var(--thumb);
      height: var(--thumb);
      margin-top: 7px;
      border: 0;
      border-radius: 50%;
      background: var(--ink);
      appearance: none;
      -webkit-appearance: none;
      transition: transform .12s var(--ease);
    }
    .slider input[type="range"]:hover::-webkit-slider-thumb { transform: scale(1.08); }
    .slider input[type="range"]:active::-webkit-slider-thumb { transform: scale(1.16); }

    .slider input[type="range"]::-moz-range-track { height: 34px; background: transparent; border: 0; }
    .slider input[type="range"]::-moz-range-progress { background: transparent; }
    .slider input[type="range"]::-moz-range-thumb {
      width: var(--thumb);
      height: var(--thumb);
      border: 0;
      border-radius: 50%;
      background: var(--ink);
    }

    .slider input[type="range"]:focus-visible {
      outline: 2px solid var(--azure-line);
      outline-offset: 3px;
      border-radius: 999px;
    }

    /* ── вайб ───────────────────────────────────────────────── */
    .vibe__top {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 10px;
    }
    .vibe__word {
      margin-left: 12px;
      font-size: 12px;
      color: var(--ink-muted);
    }
    .vibe__value { display: flex; align-items: baseline; gap: 6px; }
    .vibe__num {
      font-family: var(--mono);
      font-size: 44px;
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -.05em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .vibe__unit { font-family: var(--mono); font-size: 12px; color: var(--ink-faint); }
    .vibe__note { margin: 10px 0 0; font-size: 12px; line-height: 1.5; color: var(--ink-faint); }

    /* ── низ: живой итог + кнопки ───────────────────────────── */
    .rf-foot {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 14px 28px;
      border-top: 1px solid var(--line);
      background: var(--surface);
    }

    .foot-result { display: flex; align-items: baseline; gap: 12px; min-width: 0; }
    .foot-result__label {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .foot-result__num {
      font-family: var(--mono);
      font-size: 32px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: -.04em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .foot-result__unit { font-family: var(--mono); font-size: 12px; color: var(--ink-faint); }
    .foot-grade {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--gc, var(--ink-muted));
      white-space: nowrap;
    }
    .foot-meta {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: .02em;
      color: var(--ink-faint);
      white-space: nowrap;
    }

    .foot-actions { display: flex; align-items: center; gap: 10px; flex: none; }

    .btn {
      height: 42px;
      padding: 0 20px;
      border-radius: var(--r-sm);
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: .02em;
      cursor: pointer;
      transition: background .16s var(--ease), color .16s var(--ease), border-color .16s var(--ease);
    }
    .btn--ghost {
      border: 1px solid var(--line);
      background: transparent;
      color: var(--ink-muted);
    }
    .btn--ghost:hover { border-color: var(--line-strong); color: var(--ink); }
    .btn--primary {
      border: 1px solid transparent;
      background: var(--azure);
      color: #0a0709;
    }
    .btn--primary:hover:not(:disabled) { background: var(--azure-bright); }
    .btn--primary:disabled { opacity: .42; cursor: not-allowed; }

    /* ── анимация смены числа ───────────────────────────────── */
    @keyframes num-in {
      from { opacity: .25; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .num-in { animation: num-in .16s var(--ease); }

    @media (prefers-reduced-motion: reduce) {
      .num-in { animation: none; }
      .block__chev, .slider__fill, .weights-viz__seg { transition: none; }
    }

    /* ── адаптив ────────────────────────────────────────────── */
    @media (max-width: 900px) {
      .weight-cells { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .crit { grid-template-columns: minmax(0, 1fr) minmax(200px, 2fr) 50px; gap: 14px; }
      .foot-meta { display: none; }
    }

    @media (max-width: 720px) {
      .backdrop-page { display: none; }
      .overlay { padding: 0; align-items: flex-end; }
      .dialog { max-height: 100dvh; height: 100dvh; border-radius: 0; border: 0; }
      .dialog__head { padding: 18px 20px 14px; }
      .dialog__title { font-size: 21px; }
      .rf-scroll { padding: 16px 20px 22px; }
      .rf-foot { padding: 12px 20px; flex-wrap: wrap; }
      .crit {
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas: 'label num' 'slider slider';
        gap: 2px 12px;
        padding: 10px 0;
      }
      .crit__label { grid-area: label; }
      .crit__num { grid-area: num; font-size: 24px; }
      .slider { grid-area: slider; }
      .weight-cells { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .genre-row { flex-wrap: wrap; }
      .select-wrap { max-width: none; }
      .foot-meta { display: none; }
    }

    @media (max-width: 520px) {
      .meter { display: none; }
      .foot-result { width: 100%; justify-content: space-between; }
      .foot-actions { width: 100%; }
      .btn { flex: 1; }
      .criteria-head__meta span:first-child { display: none; }
    }
  </style>
</head>
<body>

  <!-- фон, чтобы видеть масштаб модалки на странице -->
  <div class="backdrop-page" aria-hidden="true">
    <div class="bp-poster"></div>
    <div class="bp-main">
      <div class="bp-kicker"></div>
      <div class="bp-h1"></div>
      <div class="bp-line w90"></div>
      <div class="bp-line w70"></div>
      <div class="bp-line w90"></div>
      <div class="bp-line w50"></div>
    </div>
  </div>

  <div class="overlay">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="rfTitle">

      <header class="dialog__head">
        <div>
          <p class="kicker">Оценка фильма</p>
          <h1 class="dialog__title" id="rfTitle">Солярис</h1>
          <p class="dialog__sub">1972 · Андрей Тарковский</p>
        </div>
        <button type="button" class="dialog__close" aria-label="Закрыть">×</button>
      </header>

      <div class="rf-scroll">

        <!-- ── жанр и веса ──────────────────────────────────── -->
        <section class="card">
          <div class="card__head">
            <span class="lbl">Жанр и веса</span>
            <div class="weights-sum" id="weightsSum">
              Σ <b id="weightsTotal">100</b>% · <span id="weightsState">ровно 100</span>
              <button type="button" class="link-btn" id="normalizeBtn" hidden>Уровнять</button>
            </div>
          </div>

          <div class="genre-row">
            <div class="select-wrap">
              <select class="field-select" id="genreSelect" aria-label="Жанр"></select>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </div>
          </div>

          <div class="weights-viz" id="weightsViz" role="img" aria-label="Распределение весов по блокам"></div>

          <div class="weight-cells" id="weightCells"></div>
        </section>

        <!-- ── критерии ─────────────────────────────────────── -->
        <div class="criteria-head">
          <span class="lbl">Критерии</span>
          <div class="criteria-head__meta">
            <span>15 параметров · 5 блоков</span>
            <button type="button" class="link-btn" id="toggleAll">Развернуть все</button>
          </div>
        </div>

        <div class="blocks" id="blocks"></div>

        <!-- ── вайб ─────────────────────────────────────────── -->
        <section class="card">
          <div class="vibe__top">
            <div>
              <span class="lbl">Вайб</span>
              <span class="vibe__word" id="vibeWord">крепко, но не зацепило</span>
            </div>
            <div class="vibe__value">
              <span class="vibe__num" id="vibeNum">7</span>
              <span class="vibe__unit">/ 10</span>
            </div>
          </div>

          <div class="slider" id="vibeSlider" style="--fc: var(--cyan-bright)">
            <div class="slider__track"><span class="slider__fill"></span></div>
            <div class="slider__ticks"></div>
            <input type="range" min="1" max="10" step="1" value="7" aria-label="Вайб от 1 до 10" />
          </div>

          <p class="vibe__note">Субъективное впечатление. Не влияет на технический балл.</p>
        </section>

      </div>

      <footer class="rf-foot">
        <div class="foot-result">
          <span class="foot-result__label">Комбинированный</span>
          <span class="foot-result__num" id="footCombined">86.4</span>
          <span class="foot-result__unit">/100</span>
          <span class="foot-grade" id="footGrade">A · Отлично</span>
          <span class="foot-meta" id="footMeta">технический 86.4 · вайб 7</span>
        </div>
        <div class="foot-actions">
          <button type="button" class="btn btn--ghost">Отмена</button>
          <button type="button" class="btn btn--primary" id="saveBtn">Сохранить оценку</button>
        </div>
      </footer>

    </div>
  </div>

  <script>
    /* ── данные (те же, что в src/utils/constants.js) ───────── */
    const BLOCKS = [
      { key: 'scenario', name: 'Сценарий и драматургия', short: 'Сценарий', color: '#7dd9e3', criteria: [
        { key: 'plot', name: 'Сюжетная архитектура', hint: 'Логика событий, завязка-развязка, причинно-следственные связи.' },
        { key: 'ideas', name: 'Идейная нагрузка', hint: 'Понятность целей героев, развитие темы, вложенный смысл.' },
        { key: 'dialogue', name: 'Диалоги и подтекст', hint: 'Естественность речи, скрытые смыслы, многослойность.' }
      ]},
      { key: 'characters', name: 'Персонажи и актёрская игра', short: 'Персонажи', color: '#5fc9d4', criteria: [
        { key: 'depth', name: 'Глубина и эволюция', hint: 'Внутренние конфликты, трансформация под давлением, развитие героев.' },
        { key: 'chemistry', name: 'Химия и органика', hint: 'Мимика, паузы, взгляды, естественность взаимодействия.' },
        { key: 'functionality', name: 'Функциональность', hint: 'Каждый персонаж важен для сюжета, нет ли лишних?' }
      ]},
      { key: 'visual', name: 'Режиссура и визуальный язык', short: 'Визуал', color: '#5b9bd5', criteria: [
        { key: 'composition', name: 'Композиция и символизм', hint: 'Продуманность и эстетичность кадра, визуальные метафоры.' },
        { key: 'cinematography', name: 'Операторская работа и монтаж', hint: 'Движение камеры, ритм склеек, работают ли они на смысл?' },
        { key: 'pacing', name: 'Темп и ритм', hint: 'Динамика, удержание внимания, соответствие жанру.' },
        { key: 'tone', name: 'Эмоциональная целостность', hint: 'Фильм держит единое настроение или разваливается?' }
      ]},
      { key: 'sound', name: 'Звук и атмосфера', short: 'Звук', color: '#8b88d4', criteria: [
        { key: 'music', name: 'Музыка и тишина', hint: 'Передача эмоций через музыку, подходит ли она фильму, используется ли тишина как приём?' },
        { key: 'design', name: 'Звуковой дизайн', hint: 'Работа шумов для погружения, соответствие эпохе.' },
        { key: 'narrative', name: 'Нарративный звук', hint: 'Вклад звука в историю: масштаб, тревога, интимность.' }
      ]},
      { key: 'style', name: 'Авторский стиль', short: 'Стиль', color: '#d68aa6', criteria: [
        { key: 'originality', name: 'Индивидуальность', hint: 'Уникальный голос режиссёра, авторский почерк.' },
        { key: 'boldness', name: 'Художественная смелость', hint: 'Риск формой, жанром, нарративом.' }
      ]}
    ];

    const GENRES = {
      '': 'Без жанра — базовые веса',
      drama: 'Драма / Арт-хаус',
      action: 'Экшн / Блокбастер',
      comedy: 'Комедия',
      horror: 'Хоррор / Триллер',
      scifi_block: 'Sci-Fi / Фэнтези (блокбастер)',
      scifi_author: 'Sci-Fi / Фэнтези (авторский)',
      musical: 'Мюзикл',
      biopic: 'Байопик',
      hybrid: 'Свои веса'
    };

    const PRESETS = {
      drama: [25, 20, 20, 15, 20],
      action: [20, 20, 30, 20, 10],
      comedy: [30, 30, 15, 15, 10],
      horror: [25, 20, 20, 25, 10],
      scifi_block: [25, 20, 25, 20, 10],
      scifi_author: [20, 20, 25, 15, 20],
      musical: [20, 20, 20, 30, 10],
      biopic: [30, 30, 20, 15, 5]
    };

    const VIBE_WORDS = {
      1: 'провал', 2: 'провал', 3: 'не зашло', 4: 'не зашло', 5: 'нормально',
      6: 'крепко, но не зацепило', 7: 'крепко, но не зацепило', 8: 'сильно',
      9: 'восторг', 10: 'идеально'
    };

    const state = {
      genre: 'hybrid',
      weights: [25, 20, 20, 15, 20],
      vibe: 7,
      scores: {
        scenario: { plot: 9, ideas: 9, dialogue: 8 },
        characters: { depth: 9, chemistry: 8, functionality: 8 },
        visual: { composition: 9, cinematography: 9, pacing: 8, tone: 9 },
        sound: { music: 8, design: 8, narrative: 9 },
        style: { originality: 9, boldness: 8 }
      },
      open: { scenario: true }
    };

    /* ── расчёты (как в scoring.js) ─────────────────────────── */
    const round1 = v => Math.round(v * 10) / 10;

    const blockAvg = block => {
      const values = block.criteria.map(c => state.scores[block.key][c.key]);
      return values.reduce((s, v) => s + v, 0) / values.length;
    };

    const technical = () => {
      const weighted = BLOCKS.reduce((sum, b, i) => sum + blockAvg(b) * state.weights[i], 0);
      return round1((weighted / 100) * 10);
    };

    const combined = () => {
      const t = technical();
      return round1(t * 0.7 + state.vibe * 3);
    };

    const gradeOf = score => {
      if (score >= 90) return { letter: 'S', label: 'Шедевр', color: '#d68aa6' };
      if (score >= 80) return { letter: 'A', label: 'Отлично', color: '#7dd9e3' };
      if (score >= 65) return { letter: 'B', label: 'Хорошо', color: '#5fc9d4' };
      if (score >= 50) return { letter: 'C', label: 'Средне', color: '#5b9bd5' };
      if (score >= 35) return { letter: 'D', label: 'Слабо', color: '#8f8289' };
      return { letter: 'E', label: 'Провал', color: '#a86a72' };
    };

    const fmt = v => (Number.isInteger(v) ? String(v) : v.toFixed(1));

    /* ── DOM-хелперы ────────────────────────────────────────── */
    const $ = sel => document.querySelector(sel);

    const setNum = (el, text) => {
      if (el.textContent === text) return;
      el.textContent = text;
      el.classList.remove('num-in');
      void el.offsetWidth;
      el.classList.add('num-in');
    };

    /* ── слайдер: заполнение + деления ──────────────────────── */
    const makeTicks = (container, count) => {
      container.innerHTML = '';
      for (let i = 0; i < count; i += 1) container.appendChild(document.createElement('i'));
    };

    const paintSlider = (slider, value, min, max) => {
      const p = (value - min) / (max - min);
      slider.style.setProperty('--p', p);
      const ticks = slider.querySelectorAll('.slider__ticks i');
      ticks.forEach((tick, i) => {
        const tickValue = min + ((max - min) * i) / (ticks.length - 1);
        tick.classList.toggle('is-on', tickValue <= value + 0.001);
      });
    };

    /* ── жанр ───────────────────────────────────────────────── */
    const renderGenres = () => {
      const select = $('#genreSelect');
      select.innerHTML = Object.entries(GENRES)
        .map(([key, label]) => `<option value="${key}">${label}</option>`)
        .join('');
      select.value = state.genre;
    };

    /* ── веса ───────────────────────────────────────────────── */
    const totalWeight = () => state.weights.reduce((s, w) => s + w, 0);
    const weightsValid = () => totalWeight() === 100;

    const renderWeightsViz = () => {
      const viz = $('#weightsViz');
      viz.innerHTML = BLOCKS.map((block, i) => {
        const weight = state.weights[i];
        return `<div class="weights-viz__seg" data-empty="${weight < 6}"
          style="flex-grow:${Math.max(weight, 0.0001)};background:${block.color}"
          title="${block.name}: ${weight}%">${weight}%</div>`;
      }).join('');
    };

    const renderWeightCells = () => {
      const host = $('#weightCells');
      host.innerHTML = BLOCKS.map((block, i) => `
        <div class="weight-cell">
          <div class="weight-cell__top">
            <span class="weight-cell__name"><span class="dot" style="background:${block.color}"></span>${block.short}</span>
            <span class="weight-cell__val" data-weight-val="${i}">${state.weights[i]}<span>%</span></span>
          </div>
          <div class="slider" data-weight-slider="${i}" style="--fc:${block.color}">
            <div class="slider__track"><span class="slider__fill"></span></div>
            <div class="slider__ticks"></div>
            <input type="range" min="0" max="50" step="1" value="${state.weights[i]}"
              data-weight="${i}" aria-label="Вес блока ${block.short}, 0–50 процентов" />
          </div>
        </div>`).join('');

      BLOCKS.forEach((block, i) => {
        const slider = host.querySelector(`[data-weight-slider="${i}"]`);
        makeTicks(slider.querySelector('.slider__ticks'), 6);
        paintSlider(slider, state.weights[i], 0, 50);
      });
    };

    const paintWeightsSum = () => {
      const total = totalWeight();
      const valid = weightsValid();
      $('#weightsTotal').textContent = total;
      $('#weightsState').textContent = valid ? 'ровно 100' : 'нужно ровно 100';
      $('#weightsSum').classList.toggle('is-invalid', !valid);
      $('#normalizeBtn').hidden = !(state.genre === 'hybrid' && !valid);
      $('#saveBtn').disabled = !valid;
    };

    const setWeights = next => {
      state.weights = next.slice();
      renderWeightsViz();
      BLOCKS.forEach((block, i) => {
        const slider = document.querySelector(`[data-weight-slider="${i}"]`);
        slider.querySelector('input').value = state.weights[i];
        paintSlider(slider, state.weights[i], 0, 50);
        document.querySelector(`[data-weight-val="${i}"]`).innerHTML = `${state.weights[i]}<span>%</span>`;
      });
      paintWeightsSum();
    };

    const normalizeWeights = () => {
      const total = totalWeight();
      if (!total) { setWeights([30, 25, 20, 15, 10]); return; }
      const raw = state.weights.map(w => (w / total) * 100);
      const ints = raw.map(Math.floor);
      let rest = 100 - ints.reduce((s, v) => s + v, 0);
      const order = raw
        .map((v, i) => ({ i, frac: v - Math.floor(v) }))
        .sort((a, b) => b.frac - a.frac);
      for (let k = 0; k < rest; k += 1) ints[order[k % order.length].i] += 1;
      setWeights(ints);
    };

    /* ── блоки критериев ────────────────────────────────────── */
    const renderBlocks = () => {
      const host = $('#blocks');
      host.innerHTML = BLOCKS.map(block => `
        <section class="block ${state.open[block.key] ? 'is-open' : ''}" data-block="${block.key}" style="--bc:${block.color}">
          <button type="button" class="block__head" aria-expanded="${Boolean(state.open[block.key])}">
            <span class="block__name">${block.name}</span>
            <span class="meter">${Array.from({ length: 10 }, () => '<i></i>').join('')}</span>
            <span class="block__avg" data-block-avg="${block.key}" title="среднее по критериям"></span>
            <svg class="block__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="block__body">
            ${block.criteria.map(criterion => `
              <div class="crit">
                <label class="crit__label" for="crit-${block.key}-${criterion.key}">
                  ${criterion.name}
                  <span class="hint-wrap">
                    <button type="button" class="hint" aria-label="Подсказка: ${criterion.name}">i</button>
                    <span class="hint-popup" role="tooltip">${criterion.hint}</span>
                  </span>
                </label>
                <div class="slider" data-slider="${block.key}.${criterion.key}" style="--fc:${block.color}">
                  <div class="slider__track"><span class="slider__fill"></span></div>
                  <div class="slider__ticks"></div>
                  <input id="crit-${block.key}-${criterion.key}" type="range" min="1" max="10" step="1"
                    value="${state.scores[block.key][criterion.key]}"
                    data-score="${block.key}.${criterion.key}"
                    aria-label="${criterion.name}, от 1 до 10" />
                </div>
                <output class="crit__num" data-num="${block.key}.${criterion.key}">${state.scores[block.key][criterion.key]}</output>
              </div>`).join('')}
          </div>
        </section>`).join('');

      BLOCKS.forEach(block => {
        block.criteria.forEach(criterion => {
          const slider = host.querySelector(`[data-slider="${block.key}.${criterion.key}"]`);
          makeTicks(slider.querySelector('.slider__ticks'), 10);
          paintSlider(slider, state.scores[block.key][criterion.key], 1, 10);
        });
      });

      host.querySelectorAll('.block__head').forEach(head => {
        head.addEventListener('click', () => {
          const blockEl = head.closest('.block');
          const key = blockEl.dataset.block;
          state.open[key] = !state.open[key];
          blockEl.classList.toggle('is-open', state.open[key]);
          head.setAttribute('aria-expanded', String(state.open[key]));
        });
      });

      host.querySelectorAll('input[data-score]').forEach(input => {
        input.addEventListener('input', () => {
          const [blockKey, critKey] = input.dataset.score.split('.');
          const value = Number(input.value);
          state.scores[blockKey][critKey] = value;

          const slider = input.closest('.slider');
          paintSlider(slider, value, 1, 10);
          setNum(document.querySelector(`[data-num="${blockKey}.${critKey}"]`), String(value));
          paintBlock(blockKey);
          paintResult();
        });
      });
    };

    const paintBlock = blockKey => {
      const block = BLOCKS.find(b => b.key === blockKey);
      const avg = blockAvg(block);
      const rounded = Math.round(avg);
      const blockEl = document.querySelector(`[data-block="${blockKey}"]`);
      blockEl.querySelectorAll('.meter i').forEach((dot, i) => {
        dot.classList.toggle('is-on', i < rounded);
      });
      const avgEl = blockEl.querySelector(`[data-block-avg="${blockKey}"]`);
      avgEl.textContent = String(rounded);
      avgEl.title = `среднее ${avg.toFixed(1)}`;
    };

    /* ── вайб ───────────────────────────────────────────────── */
    const paintVibe = () => {
      const slider = $('#vibeSlider');
      paintSlider(slider, state.vibe, 1, 10);
      setNum($('#vibeNum'), String(state.vibe));
      $('#vibeWord').textContent = VIBE_WORDS[state.vibe];
    };

    /* ── итог ───────────────────────────────────────────────── */
    const paintResult = () => {
      const t = technical();
      const c = combined();
      const grade = gradeOf(c);
      setNum($('#footCombined'), fmt(c));
      const gradeEl = $('#footGrade');
      gradeEl.textContent = `${grade.letter} · ${grade.label}`;
      gradeEl.style.setProperty('--gc', grade.color);
      $('#footMeta').textContent = `технический ${fmt(t)} · вайб ${state.vibe}`;
    };

    const paintAll = () => {
      BLOCKS.forEach(block => paintBlock(block.key));
      paintVibe();
      paintResult();
      paintWeightsSum();
    };

    /* ── события ────────────────────────────────────────────── */
    $('#genreSelect').addEventListener('change', event => {
      const key = event.target.value;
      state.genre = key;
      if (key === 'hybrid') return;
      setWeights(key === '' ? [30, 25, 20, 15, 10] : (PRESETS[key] || [30, 25, 20, 15, 10]));
    });

    $('#weightCells').addEventListener('input', event => {
      const input = event.target.closest('input[data-weight]');
      if (!input) return;
      const index = Number(input.dataset.weight);
      state.weights[index] = Number(input.value);
      state.genre = 'hybrid';
      $('#genreSelect').value = 'hybrid';

      const slider = input.closest('.slider');
      paintSlider(slider, state.weights[index], 0, 50);
      document.querySelector(`[data-weight-val="${index}"]`).innerHTML = `${state.weights[index]}<span>%</span>`;
      renderWeightsViz();
      paintWeightsSum();
      paintResult();
    });

    $('#vibeSlider').querySelector('input').addEventListener('input', event => {
      state.vibe = Number(event.target.value);
      paintVibe();
      paintResult();
    });

    $('#normalizeBtn').addEventListener('click', normalizeWeights);

    $('#toggleAll').addEventListener('click', () => {
      const allOpen = BLOCKS.every(b => state.open[b.key]);
      BLOCKS.forEach(b => { state.open[b.key] = !allOpen; });
      document.querySelectorAll('.block').forEach(blockEl => {
        const key = blockEl.dataset.block;
        blockEl.classList.toggle('is-open', state.open[key]);
        blockEl.querySelector('.block__head').setAttribute('aria-expanded', String(state.open[key]));
      });
      $('#toggleAll').textContent = allOpen ? 'Развернуть все' : 'Свернуть все';
    });

    /* ── старт ──────────────────────────────────────────────── */
    renderGenres();
    renderWeightsViz();
    renderWeightCells();
    renderBlocks();
    makeTicks($('#vibeSlider').querySelector('.slider__ticks'), 10);
    paintAll();
  </script>
</body>
</html>
</file>

